    "creator_notes": "Best with long replies.",
    "system_prompt": "You are {{char}}. {{original}}",
    "post_history_instructions": "Stay in character.",
    "alternate_greetings": ["Oh, it's you again, {{user}}.", "{{random::Hi::Hello}} there."],
    "tags": ["fantasy", "tavern"],
    "creator": "someone",
    "character_version": "1.0",
    "extensions": {
      "talkativeness": "0.5",
      "fav": false,
      "world": "Rain Lamp Lore",
      "depth_prompt": { "prompt": "Remember the weather.", "depth": 3, "role": "system" },
      "regex_scripts": [
        { "id": "r1", "scriptName": "Hide thoughts", "findRegex": "/<think>[\\s\\S]*?<\\/think>/gs", "replaceString": "", "trimStrings": [], "placement": [2], "disabled": false, "markdownOnly": true, "promptOnly": false, "runOnEdit": true, "substituteRegex": 0, "minDepth": null, "maxDepth": null },
        { "id": "r2", "scriptName": "Damage", "findRegex": "/\\[DMG (\\d+)\\]/g", "replaceString": "<var>hp -= $1</var>", "placement": [2], "disabled": false, "markdownOnly": false, "promptOnly": false },
        { "id": "r3", "scriptName": "Broken", "findRegex": "/(unclosed/g", "replaceString": "{{match}}", "placement": [1, 2], "disabled": false, "markdownOnly": false, "promptOnly": true },
        { "id": "r4", "scriptName": "WI only", "findRegex": "/x/g", "replaceString": "y", "placement": [5], "disabled": false }
      ]
    },
    "character_book": {
      "name": "Rain Lamp Book",
      "entries": [
        { "id": 1, "keys": ["lighthouse", "Oswin"], "secondary_keys": [], "content": "The old lighthouse is kept by Oswin.", "enabled": true, "insertion_order": 100, "constant": false, "selective": true, "comment": "Lighthouse", "position": "before_char", "extensions": { "position": 0, "depth": 4, "selectiveLogic": 0, "probability": 100, "useProbability": true, "scan_depth": null, "case_sensitive": null, "match_whole_words": null, "role": 0 } },
        { "id": 2, "keys": [], "content": "The city is called Fog Harbor.", "enabled": true, "insertion_order": 50, "constant": true, "comment": "City", "position": "after_char", "extensions": { "position": 1 } },
        { "id": 3, "keys": ["storm"], "secondary_keys": ["ship", "boat"], "content": "Storms sink ships here. {{random::a::b}}", "enabled": true, "insertion_order": 10, "constant": false, "selective": true, "comment": "Storms", "extensions": { "position": 4, "depth": 2, "role": 0, "selectiveLogic": 2, "scan_depth": 5, "probability": 50, "useProbability": true } },
        { "id": 4, "keys": [], "content": "Never triggers.", "enabled": true, "insertion_order": 100, "constant": false, "comment": "Orphan", "extensions": { "position": 0 } },
        { "id": 5, "keys": ["outlet"], "content": "Outlet content", "enabled": true, "insertion_order": 100, "comment": "Outlet", "extensions": { "position": 7 } }
      ]
    }
  }
